# Copie este arquivo para .env e preencha. O .env não vai para o Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=protocolo
DB_PASSWORD=
DB_NAME=protocolo

# Banco usado pelo pytest (é apagado e recriado a cada execução)
TEST_DB_NAME=protocolo_teste

# Chave das sessões do Flask: qualquer texto longo e aleatório
SECRET_KEY=

# Senhas dos usuários de demonstração criados pelo database/seed.py
SENHA_AVALIADOR=
SENHA_TESTADOR=

# Só para banco na nuvem: caminho do certificado CA do provedor (ex.: /etc/secrets/ca.pem)
DB_SSL_CA=
